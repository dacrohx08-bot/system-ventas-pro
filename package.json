{
  "name": "system-ventas-pro",
  "productName": "SYSTEM VENTAS PRO",
  "version": "12.85.16",
  "description": "SYSTEM VENTAS PRO - Punto de venta, inventario y reportes",
  "author": "SYSTEM VENTAS PRO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.systemventaspro.app",
    "productName": "SYSTEM VENTAS PRO",
    "copyright": "SYSTEM VENTAS PRO",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "package.json"],
    "publish": [{ "provider": "github", "owner": "dacrohx08-bot", "repo": "system-ventas-pro", "releaseType": "release" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "SystemVentasPro-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SYSTEM VENTAS PRO",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }, { "target": "zip", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "SystemVentasPro-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "SystemVentasPro.${ext}"
    }
  }
}
